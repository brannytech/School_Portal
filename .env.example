# Local installation: copy to .env, npm ci, npm run build, npm start.
NODE_ENV=development
# Development sandbox role buttons on the sign-in page. Off by default; set to true only on a private dev machine.
DEMO_MODE=false
PORT=3000
HOST=127.0.0.1
DATA_DIR=data
INITIAL_SESSION=
SELF_REGISTRATION=false
COOKIE_SECURE=false

# Production: use a separate, empty DATA_DIR and disable the sandbox.
# NODE_ENV=production
# DEMO_MODE=false
# SESSION_SECRET=<generate-at-least-32-random-characters>
# ADMIN_EMAIL=<school-administrator-email>
# ADMIN_PASSWORD=<at-least-14-random-characters>
# COOKIE_SECURE=true
# HOST=0.0.0.0

# SQLite is used when DATABASE_URL is absent.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# DATABASE_SSL=true

# Local private disk is supported; use an encrypted persistent volume.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=<private-bucket>
# S3_REGION=<region-or-auto>
# S3_ENDPOINT=<https-endpoint-for-r2-or-other-s3-service>
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=<server-only-key>
# AWS_SECRET_ACCESS_KEY=<server-only-secret>
